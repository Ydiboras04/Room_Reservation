{
  "info": {
    "name": "Room Booking API",
    "description": "API de réservation de salles (axum).\n\nLancer le serveur : `cargo run` (écoute sur 127.0.0.1:3000, variable `ADDR` pour changer).\nLancer la collection : `postman collection run postman/room_booking.postman_collection.json`.\n\nLes dossiers forment un scénario : exécutez-les dans l'ordre. Les ids créés sont stockés dans les variables de collection, et le dernier dossier libère les créneaux pour pouvoir relancer.\n\nUtilisateurs de départ : A-001, A-002 (demandeurs), RESP-001 (responsable). Salles : R-101 (30 places), R-102 (20), R-001 (amphi, 100).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates calculées à chaque requête, en heure locale (celle du serveur en local).",
          "// eventDate = aujourd'hui + 3 jours : respecte R4 (au moins 24h, au plus 30 jours à l'avance).",
          "const fmt = d => [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-');",
          "const today = new Date();",
          "const event = new Date(today); event.setDate(today.getDate() + 3);",
          "pm.collectionVariables.set('today', fmt(today));",
          "pm.collectionVariables.set('eventDate', fmt(event));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "eventDate",
      "value": ""
    },
    {
      "key": "standardId",
      "value": ""
    },
    {
      "key": "amphiId",
      "value": ""
    },
    {
      "key": "amphiToDeclineId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Catalogue",
      "item": [
        {
          "name": "Lister les salles",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms"
              ]
            },
            "description": "Public : pas d'en-tête X-User-Id nécessaire."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 200\", () => pm.response.to.have.status(200));",
                  "const rooms = pm.response.json();",
                  "pm.test(\"liste non vide\", () => pm.expect(rooms).to.be.an(\"array\").that.is.not.empty);",
                  "pm.test(\"format d'une salle\", () => rooms.forEach(r => pm.expect(r).to.have.all.keys(\"id\", \"name\", \"capacity\", \"kind\")));",
                  "pm.test(\"contient l'amphi R-001\", () => pm.expect(rooms.find(r => r.id === \"R-001\").kind).to.eql(\"amphi\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Salle standard (confirmée directement)",
      "item": [
        {
          "name": "Réserver la salle 101",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "A-001"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"room_ids\": [\n    \"R-101\"\n  ],\n  \"participants\": 20,\n  \"event_date\": \"{{eventDate}}\",\n  \"event_start\": \"10:00\",\n  \"event_end\": \"11:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"statut 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"confirmée\", () => { pm.expect(body.outcome).to.eql(\"confirmed\"); pm.expect(body.booking.status).to.eql(\"approved\"); });",
                  "pm.test(\"en-tête Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/bookings/${body.booking.id}`));",
                  "pm.collectionVariables.set(\"standardId\", body.booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter (demandeur)",
          "request": {
